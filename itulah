<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trivia Seru</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap');

        :root {
            --primary: #6366f1;
            --success: #22c55e;
            --danger: #ef4444;
            --bg: #0f172a;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e2937 100%);
            color: #e2e8f0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .container {
            width: 100%;
            max-width: 600px;
            padding: 20px;
        }

        .card {
            background: rgba(255,255,255,0.1);
            backdrop-filter: blur(16px);
            border-radius: 24px;
            border: 1px solid rgba(255,255,255,0.2);
            padding: 40px 30px;
            box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.4);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        h1 {
            font-size: 3rem;
            text-align: center;
            margin-bottom: 10px;
            background: linear-gradient(to right, #a5b4fc, #c4d0ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .subtitle {
            text-align: center;
            color: #94a3b8;
            margin-bottom: 40px;
            font-size: 1.1rem;
        }

        button {
            background: var(--primary);
            color: white;
            border: none;
            padding: 16px 32px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 9999px;
            cursor: pointer;
            transition: all 0.3s ease;
            width: 100%;
            margin-top: 20px;
        }

        button:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 25px -5px rgb(99 102 241 / 0.3);
        }

        .screen {
            display: none;
        }

        .screen.active {
            display: block;
            animation: fadeIn 0.5s ease forwards;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .question {
            font-size: 1.4rem;
            line-height: 1.4;
            margin-bottom: 30px;
            min-height: 80px;
        }

        .options {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .option {
            background: rgba(255,255,255,0.08);
            border: 2px solid rgba(255,255,255,0.1);
            padding: 18px 20px;
            border-radius: 16px;
            font-size: 1.1rem;
            cursor: pointer;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .option:hover {
            background: rgba(99, 102, 241, 0.2);
            border-color: var(--primary);
            transform: translateX(8px);
        }

        .option.selected {
            border-color: var(--primary);
            background: rgba(99, 102, 241, 0.3);
        }

        .timer-container {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 25px 0;
        }

        .timer-bar {
            flex: 1;
            height: 12px;
            background: rgba(255,255,255,0.1);
            border-radius: 9999px;
            overflow: hidden;
        }

        .timer-progress {
            height: 100%;
            background: linear-gradient(to right, #22c55e, #eab308);
            width: 100%;
            transition: width 0.2s linear;
        }

        .timer-text {
            font-weight: 700;
            font-size: 1.3rem;
            width: 60px;
            text-align: right;
        }

        .progress {
            text-align: center;
            color: #64748b;
            margin-bottom: 15px;
            font-size: 1rem;
        }

        .feedback {
            text-align: center;
            font-size: 1.5rem;
            margin: 20px 0;
            font-weight: 700;
            min-height: 50px;
        }

        .score {
            font-size: 2.5rem;
            font-weight: 700;
            text-align: center;
            margin: 20px 0;
        }

        .high-score {
            text-align: center;
            color: #94a3b8;
            margin-top: 10px;
        }

        .category {
            text-align: center;
            background: rgba(255,255,255,0.1);
            padding: 8px 20px;
            border-radius: 9999px;
            display: inline-block;
            margin-bottom: 20px;
            font-size: 0.95rem;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- SCREEN HOME -->
        <div id="home-screen" class="screen active">
            <div class="card">
                <h1>🎮 Trivia Seru</h1>
                <p class="subtitle">Uji pengetahuanmu!<br>10 pertanyaan menantang</p>
                
                <div style="text-align: center; margin: 30px 0;">
                    <button onclick="startGame()">MULAI GAME</button>
                </div>

                <div style="text-align: center; margin-top: 40px; font-size: 0.9rem; color: #64748b;">
                    Skor Tertinggi: <span id="high-score-home">0</span>
                </div>
            </div>
        </div>

        <!-- SCREEN QUIZ -->
        <div id="quiz-screen" class="screen">
            <div class="card">
                <div class="progress">
                    Pertanyaan <span id="current-q">1</span> / <span id="total-q">10</span>
                </div>

                <div class="category" id="category-text"></div>

                <div class="question" id="question-text"></div>

                <div class="timer-container">
                    <div class="timer-text" id="timer-text">15</div>
                    <div class="timer-bar">
                        <div class="timer-progress" id="timer-progress"></div>
                    </div>
                </div>

                <div class="options" id="options-container"></div>

                <div class="feedback" id="feedback-text"></div>

                <button id="next-btn" onclick="nextQuestion()" style="display: none;">Pertanyaan Selanjutnya →</button>
            </div>
        </div>

        <!-- SCREEN RESULT -->
        <div id="result-screen" class="screen">
            <div class="card">
                <h1 style="font-size: 2.5rem; margin-bottom: 10px;">Game Selesai!</h1>
                
                <div class="score" id="final-score">0</div>
                <div class="feedback" id="result-message" style="font-size: 1.8rem;"></div>

                <div class="high-score" id="high-score-result">
                    Skor Tertinggi: <span id="best-score">0</span>
                </div>

                <button onclick="restartGame()">Main Lagi</button>
                <button onclick="goHome()" style="background: #475569; margin-top: 12px;">Kembali ke Beranda</button>
            </div>
        </div>
    </div>

    <script>
        // Data game
        let questions = [];
        let currentQuestionIndex = 0;
        let score = 0;
        let timerInterval = null;
        let timeLeft = 15;
        let selectedAnswer = null;
        let highScore = localStorage.getItem('triviaHighScore') || 0;

        // Update high score di home
        function updateHighScoreDisplay() {
            document.getElementById('high-score-home').textContent = highScore;
            document.getElementById('best-score').textContent = highScore;
        }

        // Ambil pertanyaan dari Open Trivia Database API
        async function fetchQuestions() {
            try {
                // Amount=10, type=multiple, bahasa Inggris (bisa diubah)
                const response = await fetch('https://opentdb.com/api.php?amount=10&type=multiple');
                const data = await response.json();
                
                if (data.response_code === 0) {
                    questions = data.results.map(q => {
                        // Decode HTML entities
                        const questionText = q.question
                            .replace(/&quot;/g, '"')
                            .replace(/&#039;/g, "'")
                            .replace(/&amp;/g, '&')
                            .replace(/&lt;/g, '<')
                            .replace(/&gt;/g, '>');
                        
                        let options = [...q.incorrect_answers, q.correct_answer];
                        options = options.map(opt => 
                            opt.replace(/&quot;/g, '"')
                               .replace(/&#039;/g, "'")
                               .replace(/&amp;/g, '&')
                               .replace(/&lt;/g, '<')
                               .replace(/&gt;/g, '>')
                        );
                        
                        // Shuffle options
                        options.sort(() => Math.random() - 0.5);
                        
                        return {
                            question: questionText,
                            options: options,
                            correct: q.correct_answer
                                .replace(/&quot;/g, '"')
                                .replace(/&#039;/g, "'")
                                .replace(/&amp;/g, '&'),
                            category: q.category,
                            difficulty: q.difficulty
                        };
                    });
                } else {
                    throw new Error("Gagal mengambil pertanyaan");
                }
            } catch (error) {
                console.error(error);
                // Fallback questions jika API gagal
                questions = [
                    {
                        question: "Apa ibu kota Indonesia?",
                        options: ["Jakarta", "Surabaya", "Bandung", "Medan"],
                        correct: "Jakarta",
                        category: "General Knowledge"
                    },
                    {
                        question: "Siapa presiden pertama Republik Indonesia?",
                        options: ["Soekarno", "Soeharto", "Habibie", "Megawati"],
                        correct: "Soekarno",
                        category: "General Knowledge"
                    }
                ];
            }
        }

        function startGame() {
            currentQuestionIndex = 0;
            score = 0;
            document.getElementById('home-screen').classList.remove('active');
            document.getElementById('quiz-screen').classList.add('active');
            fetchQuestions().then(() => {
                loadQuestion();
            });
        }

        function loadQuestion() {
            if (currentQuestionIndex >= questions.length) {
                endGame();
                return;
            }

            const q = questions[currentQuestionIndex];
            
            // Reset state
            selectedAnswer = null;
            document.getElementById('feedback-text').innerHTML = '';
            document.getElementById('next-btn').style.display = 'none';
            
            // Tampilkan konten
            document.getElementById('current-q').textContent = currentQuestionIndex + 1;
            document.getElementById('total-q').textContent = questions.length;
            document.getElementById('question-text').innerHTML = q.question;
            document.getElementById('category-text').textContent = `${q.category} • ${q.difficulty}`;
            
            const optionsContainer = document.getElementById('options-container');
            optionsContainer.innerHTML = '';
            
            q.options.forEach((option, index) => {
                const div = document.createElement('div');
                div.className = 'option';
                div.innerHTML = option;
                div.onclick = () => selectAnswer(option, div);
                optionsContainer.appendChild(div);
            });
            
            startTimer();
        }

        function selectAnswer(answer, element) {
            if (selectedAnswer !== null) return; // Sudah dijawab
            
            selectedAnswer = answer;
            clearInterval(timerInterval);
            
            // Highlight pilihan
            const allOptions = document.querySelectorAll('.option');
            allOptions.forEach(opt => {
                opt.style.pointerEvents = 'none';
                if (opt.textContent === answer) {
                    opt.classList.add('selected');
                }
            });
            
            const currentQ = questions[currentQuestionIndex];
            const isCorrect = answer === currentQ.correct;
            
            if (isCorrect) {
                score += 10;
                element.style.borderColor = '#22c55e';
                element.style.background = 'rgba(34, 197, 94, 0.3)';
                document.getElementById('feedback-text').innerHTML = 
                    `<span style="color: #22c55e;">✅ Benar!</span>`;
            } else {
                element.style.borderColor = '#ef4444';
                element.style.background = 'rgba(239, 68, 68, 0.3)';
                
                // Tampilkan jawaban benar
                allOptions.forEach(opt => {
                    if (opt.textContent === currentQ.correct) {
                        opt.style.borderColor = '#22c55e';
                        opt.style.background = 'rgba(34, 197, 94, 0.2)';
                    }
                });
                
                document.getElementById('feedback-text').innerHTML = 
                    `<span style="color: #ef4444;">❌ Salah</span>`;
            }
            
            document.getElementById('next-btn').style.display = 'block';
        }

        function startTimer() {
            timeLeft = 15;
            document.getElementById('timer-text').textContent = timeLeft;
            const progress = document.getElementById('timer-progress');
            progress.style.width = '100%';
            
            if (timerInterval) clearInterval(timerInterval);
            
            timerInterval = setInterval(() => {
                timeLeft--;
                document.getElementById('timer-text').textContent = timeLeft;
                
                // Progress bar
                const percent = (timeLeft / 15) * 100;
                progress.style.width = percent + '%';
                
                if (timeLeft <= 5) {
                    progress.style.background = 'linear-gradient(to right, #ef4444, #f59e0b)';
                }
                
                if (timeLeft <= 0) {
                    clearInterval(timerInterval);
                    timeUp();
                }
            }, 1000);
        }

        function timeUp() {
            selectedAnswer = "timeout";
            const allOptions = document.querySelectorAll('.option');
            allOptions.forEach(opt => {
                opt.style.pointerEvents = 'none';
                if (opt.textContent === questions[currentQuestionIndex].correct) {
                    opt.style.borderColor = '#22c55e';
                    opt.style.background = 'rgba(34, 197, 94, 0.2)';
                }
            });
            
            document.getElementById('feedback-text').innerHTML = 
                `<span style="color: #f59e0b;">⏰ Waktu Habis!</span>`;
            
            document.getElementById('next-btn').style.display = 'block';
        }

        function nextQuestion() {
            currentQuestionIndex++;
            loadQuestion();
        }

        function endGame() {
            clearInterval(timerInterval);
            document.getElementById('quiz-screen').classList.remove('active');
            document.getElementById('result-screen').classList.add('active');
            
            document.getElementById('final-score').textContent = score;
            
            let message = '';
            const percent = (score / (questions.length * 10)) * 100;
            
            if (percent >= 90) message = '🏆 Luar Biasa!';
            else if (percent >= 70) message = '👏 Hebat!';
            else if (percent >= 50) message = '👍 Lumayan!';
            else message = 'Coba lagi, kamu pasti bisa!';
            
            document.getElementById('result-message').textContent = message;
            
            // Simpan high score
            if (score > highScore) {
                highScore = score;
                localStorage.setItem('triviaHighScore', highScore);
            }
            
            updateHighScoreDisplay();
        }

        function restartGame() {
            document.getElementById('result-screen').classList.remove('active');
            document.getElementById('quiz-screen').classList.add('active');
            currentQuestionIndex = 0;
            score = 0;
            fetchQuestions().then(() => {
                loadQuestion();
            });
        }

        function goHome() {
            document.getElementById('result-screen').classList.remove('active');
            document.getElementById('home-screen').classList.add('active');
        }

        // Inisialisasi
        window.onload = () => {
            updateHighScoreDisplay();
        };
    </script>
</body>
</html>
